{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build FOS",
            "type": "shell",
            "command": "make",
            "args": ["-j2"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Clean FOS build",
            "type": "shell",
            "command": "make",
            "args": ["clean"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Run FOS (Bochs)",
            "type": "shell",
            "command": "bochs",
            "args": ["-q", "-f", ".bochsrc"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}
